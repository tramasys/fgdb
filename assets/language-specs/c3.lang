<?xml version="1.0" encoding="UTF-8"?>
<language id="fgdb-c3" _name="C3" version="2.0" _section="Source">
  <metadata>
    <property name="globs">*.c3;*.c3i;*.c3t</property>
    <property name="line-comment-start">//</property>
    <property name="block-comment-start">/*</property>
    <property name="block-comment-end">*/</property>
  </metadata>
  <styles>
    <style id="keyword" name="Keyword" map-to="def:keyword"/>
    <style id="type" name="Type" map-to="def:type"/>
    <style id="directive" name="Directive" map-to="def:preprocessor"/>
    <style id="builtin" name="Builtin" map-to="def:function"/>
    <style id="string" name="String" map-to="def:string"/>
    <style id="comment" name="Comment" map-to="def:comment"/>
  </styles>
  <definitions>
    <context id="line-comment" style-ref="comment" class="comment" end-at-line-end="true">
      <start>//</start>
      <include><context ref="def:in-comment"/></include>
    </context>
    <context id="block-comment" style-ref="comment" class="comment">
      <start>/\*</start><end>\*/</end>
      <include><context ref="block-comment"/><context ref="def:in-comment"/></include>
    </context>
    <context id="documentation" style-ref="comment" class="comment">
      <start>&lt;\*</start><end>\*&gt;</end>
      <include><context ref="def:in-comment"/></include>
    </context>
    <context id="raw-string" style-ref="string" class="string">
      <start>`</start><end>`</end>
      <include><context><match>``</match></context></include>
    </context>
    <context id="fgdb-c3">
      <include>
        <context ref="line-comment"/>
        <context ref="block-comment"/>
        <context ref="documentation"/>
        <context ref="raw-string"/>
        <context ref="def:string"/>
        <context ref="def:single-quoted-string"/>
        <context ref="def:hexadecimal"/>
        <context ref="def:decimal"/>
        <context style-ref="directive"><match>\$\$?[a-zA-Z_][a-zA-Z_0-9]*</match></context>
        <context style-ref="builtin"><match>@[a-zA-Z_][a-zA-Z_0-9]*</match></context>
        <context style-ref="type">
          <match>\b(void|bool|char|ichar|short|ushort|int|uint|long|ulong|int128|uint128|sz|usz|iptr|uptr|float16|bfloat|float|double|float128|any|fault|typeid|untypedlist)\b</match>
        </context>
        <context style-ref="keyword">
          <match>\b(alias|assert|asm|attrdef|attrgroup|attrmacro|bitstruct|break|case|catch|constdef|const|constset|cenum|continue|default|defer|do|else|enum|extern|false|faultdef|faultset|faultconst|for|foreach|foreach_r|fn|tlocal|if|inline|import|lengthof|macro|module|nextcase|null|interface|return|static|struct|switch|true|try|typedef|distinct|union|var|while)\b</match>
        </context>
      </include>
    </context>
  </definitions>
</language>
